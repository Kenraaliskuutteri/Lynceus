#!/bin/sh
set -e
. /usr/share/debconf/confmodule

case "$1" in
    configure)
        if ! getent group lynceus >/dev/null; then
            addgroup --system lynceus
        fi
        if ! getent passwd lynceus >/dev/null; then
            adduser --system --ingroup lynceus --no-create-home \
                --home /nonexistent --shell /usr/sbin/nologin \
                --gecos "Lynceus agent" lynceus
        fi

        chown lynceus:lynceus /var/log/lynceus

        if [ ! -e /etc/lynceus/agent.conf ]; then
            db_get lynceus-agent/host; host="$RET"
            db_get lynceus-agent/port; port="$RET"
            db_get lynceus-agent/key; key="$RET"
            db_get lynceus-agent/tls; tls="$RET"

            install -o root -g lynceus -m 0640 /dev/null /etc/lynceus/agent.conf
            {
                echo "host=${host:-127.0.0.1}"
                echo "port=${port:-8000}"
                echo "id=$(hostname)"
                echo "key=$key"
                echo "interval=2"
                echo "tls=${tls:-false}"
                echo "insecure=false"
            } > /etc/lynceus/agent.conf
        fi
        ;;
esac

#DEBHELPER#

exit 0